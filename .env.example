# העתק לקובץ .env והשלם את הערכים. הקובץ .env לא נכנס לגיט.
# ב-Vercel אותם שמות מוגדרים תחת Settings → Environment Variables.

# ── חובה ──────────────────────────────────────────────────────

# קובץ ה-JSON של חשבון השירות, כולו, מקודד Base64.
# אותו קובץ שכבר בשימוש במערכת הצעות המחיר.
#   Windows PowerShell:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json")) | Set-Clipboard
GOOGLE_SERVICE_ACCOUNT_B64=

# היומן שאליו נרשמות הפגישות — בדרך כלל כתובת ה-Gmail של העסק.
# חייב להיות משותף עם כתובת חשבון השירות בהרשאת
# "ביצוע שינויים באירועים". ראה README.
CALENDAR_ID=

# ── פרטי העסק ─────────────────────────────────────────────────

# מספר לוואטסאפ, E.164 בלי הסימן +. ברירת מחדל: המספר של Chefs Wheels.
BUSINESS_PHONE_E164=972508313777

# כתובת הפגישה. מוצגת ללקוח, נכנסת לאירוע ביומן, ומזינה את כפתורי
# Waze ו-Google Maps. כשהיא ריקה הדף פשוט לא מציג כתובת.
# ⚠️ הערך הזה מגיע לדפדפן. אל תכתוב כאן שום דבר שאינו ציבורי.
BUSINESS_ADDRESS=

# מה לחפש במפות, אם שונה מהכתובת המוצגת (למשל שם העסק בגוגל מפות).
BUSINESS_MAP_QUERY=

# כתובת הבסיס של האתר, לבניית קישור הביטול שנשלח ללקוח.
# כשריק — נגזרת מכותרות הבקשה, מה שעובד גם בפריסות preview.
PUBLIC_BASE_URL=

# ── לוח הזמנים (אופציונלי — אלו ברירות המחדל) ─────────────────

# ימי עבודה. 0 = ראשון … 6 = שבת.
# WORK_WEEKDAYS=0,1,2,3,4

# שעת פתיחה וסגירה. 16 פירושו שהתור האחרון הוא 15:00–16:00.
# WORK_START_HOUR=10
# WORK_END_HOUR=16

# אורך פגישה בדקות.
# SLOT_MINUTES=60

# כמה ימים קדימה פתוחים לקביעה.
# HORIZON_DAYS=21

# כמה שעות מראש לפחות אפשר לקבוע.
# MIN_LEAD_HOURS=3

# עד כמה שעות לפני הפגישה הלקוח יכול לבטל בעצמו.
# CANCEL_CUTOFF_HOURS=24

# תקרת פגישות פתוחות לאותו מספר טלפון. בלם ספאם.
# MAX_OPEN_PER_PHONE=2
